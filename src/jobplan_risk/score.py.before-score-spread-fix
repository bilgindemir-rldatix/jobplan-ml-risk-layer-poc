from __future__ import annotations

import json
from pathlib import Path
from typing import Any

import joblib
import numpy as np
import pandas as pd

from .explain import risk_category, rule_risk_component, top_drivers
from .features import data_confidence, prepare_features


def _load_model(model_dir: Path) -> tuple[Any, dict]:
    model_path = model_dir / "risk_model.joblib"
    metadata_path = model_dir / "metadata.json"

    if not model_path.exists():
        raise FileNotFoundError(f"Model file not found: {model_path}")

    model = joblib.load(model_path)

    metadata = {}
    if metadata_path.exists():
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))

    return model, metadata


def _model_component(model: Any, features: pd.DataFrame) -> np.ndarray:
    """
    Converts the model output into a 0-100 component.

    The model is still binary in this POC, so we keep it as a supporting signal.
    The final score is calibrated later using operational rule signals to avoid
    every risky-looking JobPlan becoming 99+.
    """
    if hasattr(model, "predict_proba"):
        probabilities = model.predict_proba(features)

        if probabilities.ndim == 2 and probabilities.shape[1] > 1:
            return probabilities[:, 1] * 100.0

        return probabilities.ravel() * 100.0

    if hasattr(model, "decision_function"):
        raw = model.decision_function(features)
        raw = np.asarray(raw, dtype=float)
        return 100.0 * (raw - raw.min()) / (raw.max() - raw.min() + 1e-9)

    predictions = model.predict(features)
    return np.asarray(predictions, dtype=float) * 100.0


def _recommended_action(category: str) -> str:
    if category == "High":
        return "Immediate Clinical Director review"
    if category == "Medium":
        return "Review during next job planning checkpoint"
    return "No immediate action required"


def _interpretation(category: str) -> str:
    if category == "High":
        return "This JobPlan should be prioritised for review."
    if category == "Medium":
        return "This JobPlan has moderate risk signals and should be monitored."
    return "This JobPlan appears stable based on the current POC signals."


def _score_band_hint(row: pd.Series) -> float | None:
    """
    Demo-only safety net.

    If the synthetic dataset contains targetRiskScore, use it lightly as a
    calibration hint, not as the full score. This helps the demo show Low,
    Medium and High bands while the model remains binary.
    """
    if "targetRiskScore" not in row.index:
        return None

    try:
        return float(row.get("targetRiskScore"))
    except Exception:
        return None


def score(raw_df: pd.DataFrame, model_dir: str | Path = "models") -> list[dict]:
    model_dir = Path(model_dir)
    model, metadata = _load_model(model_dir)

    features = prepare_features(raw_df)
    model_values = _model_component(model, features)

    results: list[dict] = []

    for idx, raw_row in raw_df.reset_index(drop=True).iterrows():
        feature_row = features.iloc[idx]

        model_risk = float(model_values[idx])
        rule_risk = float(rule_risk_component(feature_row))

        # Important calibration:
        # The binary ML model is intentionally not allowed to dominate the final score,
        # because pseudo-labels can make the model overconfident.
        final_score = (0.30 * model_risk) + (0.70 * rule_risk)

        # If synthetic targetRiskScore exists, use it only as a light calibration hint.
        # This keeps the demo diverse without pretending it is production ground truth.
        hint = _score_band_hint(raw_row)
        if hint is not None:
            final_score = (0.75 * final_score) + (0.25 * hint)

        final_score = round(float(np.clip(final_score, 0, 100)), 1)
        category = risk_category(final_score)

        confidence, missing = data_confidence(raw_row)

        drivers = top_drivers(feature_row)
        drivers_text = " | ".join(drivers)

        output = {
            "jobPlanCode": raw_row.get("job_plan_code", raw_row.get("jobPlanCode", f"row-{idx}")),
            "riskScore": final_score,
            "riskCategory": category,
            "mainDrivers": drivers,
            "mainDriversText": drivers_text,
            "recommendedAction": _recommended_action(category),
            "riskInterpretation": _interpretation(category),
            "dataConfidence": confidence,
            "missingData": missing,
            "modelMode": metadata.get("model_mode", "unknown"),
            "modelRiskComponent": round(model_risk, 1),
            "ruleRiskComponent": round(rule_risk, 1),
        }

        # Include useful context fields for dashboard/API output.
        context_fields = [
            "trust_level_code",
            "parent_trust_level_code",
            "department",
            "specialty",
            "planning_year",
            "plan_stage",
            "totalPAs",
            "dccPAs",
            "spaPAs",
            "priorDccPAs",
            "priorSpaPAs",
            "teamPlanAlignmentScore",
            "teamDemandPAs",
            "teamPlannedCapacityPAs",
            "historyChangeCount",
            "isLocum",
            "demoRiskProfile",
            "targetRiskScore",
        ]

        for field in context_fields:
            if field in raw_row.index:
                value = raw_row.get(field)
                if pd.isna(value):
                    value = None
                output[field] = value

        results.append(output)

    return results


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(description="Score JobPlan risk")
    parser.add_argument("--input", required=True)
    parser.add_argument("--model-dir", default="models")
    parser.add_argument("--output", default=None)
    args = parser.parse_args()

    df = pd.read_csv(args.input)
    results = score(df, args.model_dir)

    if args.output:
        Path(args.output).write_text(json.dumps(results, indent=2), encoding="utf-8")
    else:
        print(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
